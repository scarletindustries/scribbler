*.beam
*.ez
/build
erl_crash.dump
.idea/

# Conformance fixtures: the full vendored spec-suite (wast2json output) is LARGE and
# regenerated on demand by test/scribbler/conformance/vendor/vendor.sh, so it is NOT
# committed. Only a small CURATED subset (negated below) is tracked so that `gleam test`
# runs in a fresh checkout. (The cloned testsuite lives under /build, already ignored.)
/test/scribbler/conformance/fixtures/*
# i64 is the flagship: assert_return + assert_trap (integer div/rem) + assert_invalid,
# all passing through our pipeline. The rest add control/locals/recursion variety.
!/test/scribbler/conformance/fixtures/i64.json
!/test/scribbler/conformance/fixtures/i64.*.wasm
!/test/scribbler/conformance/fixtures/nop.json
!/test/scribbler/conformance/fixtures/nop.*.wasm
!/test/scribbler/conformance/fixtures/int_literals.json
!/test/scribbler/conformance/fixtures/int_literals.*.wasm
!/test/scribbler/conformance/fixtures/local_get.json
!/test/scribbler/conformance/fixtures/local_get.*.wasm
!/test/scribbler/conformance/fixtures/labels.json
!/test/scribbler/conformance/fixtures/labels.*.wasm
!/test/scribbler/conformance/fixtures/fac.json
!/test/scribbler/conformance/fixtures/fac.*.wasm
# Exception-handling fixtures: the 4 convertible official EH `.wast` files
# (`wast2json --enable-exceptions`), kept in a SUBDIRECTORY so the main conformance glob
# does not see them. Committed so `eh_conformance_test` runs without a full re-vendor;
# regenerated by vendor.sh's EH section.
!/test/scribbler/conformance/fixtures/eh/
!/test/scribbler/conformance/fixtures/eh/*.json
!/test/scribbler/conformance/fixtures/eh/*.wasm
# GC fixtures: the official GC `.wast` suite converted with `wasm-tools json-from-wast`
# (wabt cannot parse GC text — issue #2530), kept in a SUBDIRECTORY so the main conformance
# glob does not see them. Committed so `gc_conformance_test` runs on a fresh checkout
# without wasm-tools; regenerate/expand with vendor.sh's GC section.
!/test/scribbler/conformance/fixtures/gc/
!/test/scribbler/conformance/fixtures/gc/*.json
!/test/scribbler/conformance/fixtures/gc/*.wasm

# macOS Finder metadata
.DS_Store

# The lockfile is regenerated once carder is reachable at the committed git ref.
# Commit it as soon as `gleam deps download` records the resolved carder SHA — that pin
# is what makes CI reproducible with a git dependency.
manifest.toml
